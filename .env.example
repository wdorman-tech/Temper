# Written for you on first run. This copy is for reference, and for machines
# where you'd rather not sit through the wizard — fill it in, save it as .env,
# and setup is skipped.
#
# Settings are declared in agent/manifest.ts. That file is the source of truth.
#
# One .env for the checkout, whatever folders you run the agent in. The keys
# keep the TEMPER_ prefix even after you rename the agent — they are the
# runtime's, not the agent's name.

TEMPER_ONBOARDED=1
# What the agent calls itself on the dashboard and on your phone.
TEMPER_NAME=temper

# device = the agent gets its own Codex session (recommended)
# reuse  = copy your local ~/.codex login, which will fight with your own CLI
TEMPER_CODEX_LOGIN=device

TEMPER_TZ=America/New_York

# From the Agent Update iPhone app: + → New agent → copy the token.
# Held by the supervisor, never placed in the container's environment.
# https://tryagentupdate.com/docs/quickstart
AGENT_UPDATE_TOKEN=au_live_...

# Optional. Overrides agent/codex.toml without a rebuild.
TEMPER_MODEL=

# Optional. Bills the API instead of your ChatGPT plan.
OPENAI_API_KEY=

# Gated: held by the host, handed to a tool only inside a call you approved.
WEBHOOK_TOKEN=

# A host folder to share, mounted read-only at /workspace/mounts/notes.
NOTES_DIR=

# --- Tuning. Defaults are fine; here so you know they exist. ---
# When to compact the session and start a fresh thread.
# TEMPER_ARC_TOKENS=220000
# TEMPER_ARC_TURNS=60
# Container limits.
# TEMPER_MEMORY=4g
# How many journal events to keep.
# TEMPER_JOURNAL_KEEP=200000
